le="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.School2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.Branch2}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.Branch2, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.Occupation}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><local:SearchableOccupation Code="{Binding Editor.OccupationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.StartDate}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.StartDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.EndDate}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.EndDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></StackPanel></UserControl>