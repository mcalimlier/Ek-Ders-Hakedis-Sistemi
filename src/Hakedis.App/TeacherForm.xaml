<UserControl x:Class="Hakedis.App.TeacherForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="Field" TargetType="StackPanel"><Setter Property="Margin" Value="0,0,10,12"/></Style></UserControl.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.ColumnSpan="2" Style="{StaticResource Field}"><TextBlock Text="ADI SOYADI *" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.FullName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="1" Style="{StaticResource Field}"><TextBlock Text="T.C. KİMLİK NO" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.IdentityNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="11"/></StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"><TextBlock Text="SGK SİCİL NO" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.InsuranceNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Field}"><TextBlock Text="BANKA IBAN" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.Iban, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="3" Style="{StaticResource Field}"><TextBlock Text="GÖREV YERİ / OKUL" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.School, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"><TextBlock Text="GÖREVLENDİRİLDİĞİ BRANŞ" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.Branch, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Style="{StaticResource Field}"><TextBlock Text="SGK MESLEK KODU" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.OccupationCode, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  <StackPanel Grid.Row="5" Style="{StaticResource Field}"><TextBlock Text="İŞE BAŞLAMA TARİHİ" Style="{StaticResource FieldLabel}"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.StartDate}"/></StackPanel>
  <StackPanel Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}"><TextBlock Text="İŞTEN AYRILMA TARİHİ" Style="{StaticResource FieldLabel}"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.EndDate}"/></StackPanel>
 </Grid>
</UserControl>
