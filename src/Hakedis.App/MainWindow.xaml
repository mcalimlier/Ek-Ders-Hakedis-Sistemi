<Window x:Class="Hakedis.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hakedis.App"
 Title="Ücretli Ek Ders Hakediş Sistemi" xml:lang="tr-TR" Width="1440" Height="920" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="{StaticResource Navy900Brush}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Border Margin="6" CornerRadius="15" BorderBrush="#35546F" BorderThickness="1" Background="{StaticResource Navy900Brush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- OEHS kabuğu: lacivert üst şerit ve ikonlu dikey menü. -->
  <Grid Grid.ColumnSpan="2" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent" Margin="16,0,12,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="144"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="ÜEHS" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="ÜCRETLİ EK DERS HAKEDİŞ" Foreground="#B9CBDA" FontSize="10.5" Margin="0,2,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,9,12,9"><StackPanel><TextBlock Text="AKTİF MODÜL" Foreground="#8FA8C0" FontSize="10"/><TextBlock Text="{Binding Workspace.SelectedModule.Name}" Foreground="White" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Background="#082744" BorderBrush="#24496B" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,9,12,9"><StackPanel><TextBlock Text="ÖĞRETMEN KAYITLARI" Foreground="#8FA8C0" FontSize="10"/><TextBlock Text="{Binding Teachers.CountText}" Foreground="#FFE2A1" FontSize="12" Margin="0,3,0,0"/></StackPanel></Border>
   <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource WindowButton}" Content="—" ToolTip="Küçült" Click="Minimize_Click"/><Button Style="{StaticResource WindowButton}" Content="□" ToolTip="Büyüt / Geri Yükle" Click="Maximize_Click"/><Button Style="{StaticResource WindowButton}" Content="×" ToolTip="Kapat" FontSize="20" Click="Close_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,15,0,0">
    <TextBlock Text="İŞLEM MENÜSÜ" Foreground="#8FA8C0" FontSize="10.5" Margin="20,0,0,16"/>
    <Button Tag="Entry" Click="Navigate_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Height" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding EntryVisible}" Value="True"><Setter Property="Uid" Value="Active"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" Foreground="White" Width="34" FontSize="16"/><TextBlock Text="VERİ GİRİŞİ" Foreground="White"/></StackPanel></Button>
    <Button Tag="Calculation" Click="Navigate_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Height" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding CalculationVisible}" Value="True"><Setter Property="Uid" Value="Active"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EF;" Foreground="White" Width="34" FontSize="16"/><TextBlock Text="HAKEDİŞ HESAPLA" Foreground="White"/></StackPanel></Button>
    <Button Tag="Teachers" Click="Navigate_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Height" Value="48"/><Style.Triggers><DataTrigger Binding="{Binding TeachersVisible}" Value="True"><Setter Property="Uid" Value="Active"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE716;" Foreground="White" Width="34" FontSize="16"/><TextBlock Text="ÜCRETLİ ÖĞRETMEN&#x0a;LİSTESİ" Foreground="White"/></StackPanel></Button>
    <Border Height="1" Background="#35546F" Margin="18,22"/>
    <TextBlock Text="Öğretmen kaydını oluşturun, dönem bilgilerini girin ve hakedişi hesaplayın." TextWrapping="Wrap" Foreground="#B9CBDA" Margin="20,0,20,0" FontSize="11.5"/>
   </StackPanel>
   <Border Grid.Row="1" Background="#082744" CornerRadius="10" BorderBrush="#73581E" BorderThickness="1" Margin="12" Padding="12"><StackPanel><TextBlock Text="{Binding Workspace.SelectedModule.Name}" Foreground="{StaticResource Gold500Brush}"/><TextBlock Text="Ücretli Öğretmen Ek Ders Ödemeleri" Foreground="#B9CBDA" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="14,0,14,0" Padding="22,18">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/></StackPanel><Border Grid.Column="1" Background="#EAF0F7" CornerRadius="7" Padding="10,6" VerticalAlignment="Top" Margin="12,0,0,0"><TextBlock Text="ÜCRETLİ EK DERS" Foreground="#526277" FontSize="10.5"/></Border></Grid>

    <!-- VERİ GİRİŞİ: Yeni kayıt yalnızca burada yapılır. -->
    <Grid Grid.Row="1" Visibility="{Binding EntryVisible, Converter={StaticResource Visible}}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0"><StackPanel>
      <Border Style="{StaticResource WorkspaceCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,18,0"><TextBlock Text="MODÜL SEÇİMİ" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Workspace.Modules}" SelectedItem="{Binding Workspace.SelectedModule}" DisplayMemberPath="DisplayName"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="BÜTÇE YILI" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Workspace.Year, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="ÖDEME AYI (1–12)" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Workspace.Month, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </Grid></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource WorkspaceCard}" VerticalAlignment="Top"><StackPanel DataContext="{Binding Registration}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Border Style="{StaticResource SectionNumber}"><TextBlock Text="01" Foreground="{StaticResource Gold500Brush}" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="Öğretmen Bilgileri" Style="{StaticResource CardTitle}"/><TextBlock Text="Yeni öğretmen kaydı" Style="{StaticResource CardSubtitle}"/></StackPanel></StackPanel>
        <WrapPanel><Button Content="Öğretmeni Kaydet" Style="{StaticResource GoldAction}" Click="RegisterTeacher_Click"/><Button Content="Formu Temizle" Style="{StaticResource SecondaryAction}" Click="NewTeacher_Click"/></WrapPanel>
        <TextBlock Text="{Binding Status}" Style="{StaticResource ValidationText}" Margin="0,4,0,12"/>
        <local:TeacherForm/>
       </StackPanel></Border>
       <StackPanel Grid.Column="2">
        <Border Style="{StaticResource WorkspaceCard}"><StackPanel DataContext="{Binding Workspace}" IsEnabled="{Binding IsAvailable}">
         <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Border Style="{StaticResource SectionNumber}"><TextBlock Text="02" Foreground="{StaticResource Gold500Brush}" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="Aylık Ders Bilgileri" Style="{StaticResource CardTitle}"/><TextBlock Text="Öğretmen ve puantaj seçimi" Style="{StaticResource CardSubtitle}"/></StackPanel></StackPanel>
         <TextBlock Text="KAYITLI ÖĞRETMEN" Style="{StaticResource FieldLabel}"/>
         <ComboBox Style="{StaticResource FormCombo}" Margin="0,5,0,12" ItemsSource="{Binding DataContext.Teachers.Records, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.CalculationTeacher, RelativeSource={RelativeSource AncestorType=Window}}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding FullName}"/><Run Text=" · "/><Run Text="{Binding School}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
         <TextBlock Text="ADI SOYADI / HESAP KAYDI" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Person, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="GÜNDÜZ DERS SAATİ" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding DayHours, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DYK DERS SAATİ" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding DykHours, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
         <TextBlock Text="İCRA KESİNTİSİ (TL)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/><TextBox Style="{StaticResource FormText}" Text="{Binding Garnishment, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel></Border>
        <Border Style="{StaticResource WorkspaceCard}"><StackPanel DataContext="{Binding Workspace}" IsEnabled="{Binding IsAvailable}">
         <TextBlock Text="Dönem Parametreleri" Style="{StaticResource CardTitle}"/><TextBlock Text="Katsayı ve vergi istisnaları" Style="{StaticResource CardSubtitle}" Margin="0,0,0,16"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,12,12"><TextBlock Text="AYLIK KATSAYI" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Coefficient, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,0,12"><TextBlock Text="GÖSTERGE" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Indicator, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,12,0"><TextBlock Text="GV İSTİSNA MATRAHI" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding IncomeExemption, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="DV İSTİSNA TABANI" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding StampExemption, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
         </Grid>
        </StackPanel></Border>
       </StackPanel>
      </Grid>
      <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,14"><TextBlock Text="{Binding Workspace.Status}" Foreground="#334155" TextWrapping="Wrap"/></Border>
      <WrapPanel><Button Content="Taslak Aç" Style="{StaticResource SecondaryAction}" Click="Open_Click"/><Button Content="Taslağı Kaydet" Style="{StaticResource Action}" Click="Save_Click" IsEnabled="{Binding Workspace.IsAvailable}"/><Button Content="Hakediş Hesapla →" Style="{StaticResource GoldAction}" Tag="Calculation" Click="Navigate_Click"/></WrapPanel>
      <TextBlock Text="Başlangıç parametreleri Eylül 2026 Excel kaynağına aittir. Ödeme öncesinde dönem bilgilerini kontrol edin." Foreground="#526277" TextWrapping="Wrap" Margin="0,8,0,8"/>
     </StackPanel></ScrollViewer>
    </Grid>

    <!-- HAKEDİŞ HESAPLAMA -->
    <Grid Grid.Row="1" Visibility="{Binding CalculationVisible, Converter={StaticResource Visible}}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel DataContext="{Binding Workspace}">
     <Border Style="{StaticResource WorkspaceCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hesaplanacak Öğretmen" Style="{StaticResource CardSubtitle}"/><TextBlock Text="{Binding Person}" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedModule.Name}" Style="{StaticResource CardSubtitle}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="Veri Girişine Dön" Style="{StaticResource SecondaryAction}" Tag="Entry" Click="Navigate_Click"/><Button Content="Hakedişi Hesapla" Style="{StaticResource GoldAction}" Click="Calculate_Click" IsEnabled="{Binding IsAvailable}"/></WrapPanel></Grid></Border>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource MetricCard}" Padding="18"><StackPanel><TextBlock Text="BRÜT ÜCRET" Style="{StaticResource CardSubtitle}"/><TextBlock Text="{Binding GrossText}" Style="{StaticResource MetricValue}"/><TextBlock Text="Ders ücreti toplamı" Style="{StaticResource CardSubtitle}" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="18"><StackPanel><TextBlock Text="TOPLAM TAHAKKUK" Style="{StaticResource CardSubtitle}"/><TextBlock Text="{Binding AccrualText}" Style="{StaticResource MetricValue}"/><TextBlock Text="İşveren SGK payı dahil" Style="{StaticResource CardSubtitle}" Margin="0,6,0,0"/></StackPanel></Border>
      <Border Grid.Column="4" Style="{StaticResource MetricCard}" Padding="18" BorderBrush="{StaticResource Gold500Brush}" BorderThickness="2"><StackPanel><TextBlock Text="NET ÖDENECEK TUTAR" Foreground="{StaticResource Gold500Brush}"/><TextBlock Text="{Binding NetText}" Style="{StaticResource MetricValue}"/><TextBlock Text="Kesintiler sonrası ödeme" Style="{StaticResource CardSubtitle}" Margin="0,6,0,0"/></StackPanel></Border>
     </Grid>
     <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,16"><TextBlock Text="{Binding Status}" Foreground="#334155" TextWrapping="Wrap"/></Border>
     <Border Style="{StaticResource WorkspaceCard}"><StackPanel><TextBlock Text="Hesap Dökümü" Style="{StaticResource CardTitle}"/><TextBlock Text="Brüt ücret, prim ve kesinti ayrıntıları" Style="{StaticResource CardSubtitle}" Margin="0,0,0,14"/><Border Background="White" CornerRadius="8" Padding="12"><ItemsControl ItemsSource="{Binding Details}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="7,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="#334155" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#0B1830" FontWeight="Bold" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel></Border>
    </StackPanel></ScrollViewer></Grid>

    <!-- ÖĞRETMEN LİSTESİ: yeni kayıt işlemi yoktur. -->
    <Grid Grid.Row="1" Visibility="{Binding TeachersVisible, Converter={StaticResource Visible}}"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel DataContext="{Binding Teachers}">
     <Border Style="{StaticResource WorkspaceCard}"><StackPanel>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kayıtlı Öğretmenler" Style="{StaticResource CardTitle}"/><TextBlock Text="{Binding CountText}" Style="{StaticResource CardSubtitle}"/></StackPanel><Button Grid.Column="1" Content="Veri Girişine Git" Style="{StaticResource SecondaryAction}" Tag="Entry" Click="Navigate_Click"/></Grid>
      <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" Height="245" RowHeight="36" HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns><DataGridTextColumn Header="ADI SOYADI" Binding="{Binding FullName}" Width="190"/><DataGridTextColumn Header="T.C. KİMLİK NO" Binding="{Binding IdentityNumber}" Width="130"/><DataGridTextColumn Header="GÖREV YERİ" Binding="{Binding School}" Width="220"/><DataGridTextColumn Header="BRANŞ" Binding="{Binding Branch}" Width="160"/><DataGridTextColumn Header="BANKA IBAN" Binding="{Binding Iban}" Width="240"/><DataGridTextColumn Header="SGK SİCİL NO" Binding="{Binding InsuranceNumber}" Width="160"/></DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,14,0,0"><Button Content="Seçili Öğretmeni Veri Girişine Al" Style="{StaticResource Action}" Click="UseTeacher_Click" IsEnabled="{Binding HasSelection}"/><Button Content="Kaydı Sil" Style="{StaticResource DeleteAction}" Click="DeleteTeacher_Click" IsEnabled="{Binding HasSelection}"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource StatusBanner}" Margin="0,0,0,16"><TextBlock Text="{Binding Status}" Foreground="#334155" TextWrapping="Wrap"/></Border>
     <Border Style="{StaticResource WorkspaceCard}" IsEnabled="{Binding HasSelection}"><StackPanel>
      <TextBlock Text="Seçili Öğretmen Bilgileri" Style="{StaticResource CardTitle}"/><TextBlock Text="Listeden bir öğretmen seçerek kayıtlı bilgilerini güncelleyebilirsiniz." Style="{StaticResource CardSubtitle}" Margin="0,0,0,16"/>
      <Button Content="Değişiklikleri Kaydet" Style="{StaticResource GoldAction}" Click="SaveTeacher_Click" HorizontalAlignment="Left" IsEnabled="{Binding HasSelection}"/>
      <local:TeacherForm MaxWidth="900" HorizontalAlignment="Stretch"/>
     </StackPanel></Border>
    </StackPanel></ScrollViewer></Grid>
   </Grid>
  </Border>
 </Grid>
 </Border>
</Window>
