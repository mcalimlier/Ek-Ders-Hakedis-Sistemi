<Window x:Class="Hakedis.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ücretli Ek Ders Hakediş Sistemi" Width="1180" Height="800" MinWidth="980" MinHeight="650" Background="#F7F9FC" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#2468D8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,12,10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#082744"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#031C38" Padding="20"><StackPanel>
   <TextBlock Text="ÜCRETLİ EK DERS" Foreground="#FFB41F" FontSize="20" FontWeight="Bold"/>
   <TextBlock Text="Hakediş Sistemi" Foreground="White" FontSize="17" Margin="0,5,0,35"/>
   <TextBlock Text="HESAPLAMA MODÜLÜ" Foreground="#B9CBDA" Margin="0,0,0,10"/>
   <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" DisplayMemberPath="DisplayName" Background="#082744" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="7,14"/></Style></ListBox.ItemContainerStyle>
    <ListBox.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ListBox.Resources>
   </ListBox>
   <TextBlock Text="Her modül kendi hesaplama çekirdeğini kullanır." Foreground="#B9CBDA" TextWrapping="Wrap" Margin="0,25,0,0"/>
  </StackPanel></Border>
  <Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Aylık hesaplama çalışma alanı" FontSize="25" FontWeight="Bold" Foreground="#0B1830"/><TextBlock Text="İlk geliştirme sürümü · Kesinleşmiş ödeme belgesi değildir" Foreground="#526277" Margin="0,6,0,16"/></StackPanel>
   <Border Grid.Row="1" Background="#FFF3D6" CornerRadius="8" Padding="12" Margin="0,0,0,16"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#644500"/></Border>
   <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BRÜT ÜCRET" Foreground="#B9CBDA"/><TextBlock Text="{Binding GrossText}" Foreground="White" FontSize="24" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="İŞVEREN MALİYETİ" Foreground="#B9CBDA"/><TextBlock Text="{Binding AccrualText}" Foreground="White" FontSize="24" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="NET ÖDEME" Foreground="#FFB41F"/><TextBlock Text="{Binding NetText}" Foreground="White" FontSize="24" Margin="0,8,0,0"/></StackPanel></Border>
   </Grid>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
    <WrapPanel Margin="0,0,0,14"><Button Content="Taslak aç" Click="Open_Click"/><Button Content="Taslağı kaydet" Click="Save_Click" IsEnabled="{Binding IsAvailable}"/></WrapPanel>
    <StackPanel IsEnabled="{Binding IsAvailable}">
     <TextBlock Text="Dönem ve personel" FontWeight="Bold" FontSize="18"/>
     <WrapPanel><StackPanel Width="120"><TextBlock Text="Yıl"/><TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="100"><TextBlock Text="Ay (1–12)"/><TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="300"><TextBlock Text="Personel adı / kayıt etiketi"/><TextBox Text="{Binding Person, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
     <WrapPanel><StackPanel Width="170"><TextBlock Text="Gündüz saati"/><TextBox Text="{Binding DayHours, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="170"><TextBlock Text="DYK saati"/><TextBox Text="{Binding DykHours, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="170"><TextBlock Text="İcra kesintisi (TL)"/><TextBox Text="{Binding Garnishment, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
     <TextBlock Text="Dönem parametreleri" FontWeight="Bold" FontSize="18" Margin="0,8,0,8"/>
     <TextBlock Text="Başlangıç değerleri Eylül 2026 kaynak Excel'indendir; ödeme öncesi doğrulanmalıdır." TextWrapping="Wrap" Foreground="#526277"/>
     <WrapPanel><StackPanel Width="170"><TextBlock Text="Aylık katsayı"/><TextBox Text="{Binding Coefficient, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="170"><TextBlock Text="Gösterge"/><TextBox Text="{Binding Indicator, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="170"><TextBlock Text="GV istisna matrahı"/><TextBox Text="{Binding IncomeExemption, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Width="170"><TextBlock Text="DV istisna tabanı"/><TextBox Text="{Binding StampExemption, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
     <TextBlock Text="Kaynak kural: çalışan SGK %14 · işveren %21,75 · GV %15 · DV binde 7,59 · DYK ×2" TextWrapping="Wrap" Foreground="#526277" Margin="0,0,0,12"/>
     <Button Content="Seçili modülle hesapla" Click="Calculate_Click" HorizontalAlignment="Left"/>
    </StackPanel>
    <TextBlock Text="Hesap ayrıntıları" FontSize="18" FontWeight="Bold" Margin="0,18,0,10"/>
    <ItemsControl ItemsSource="{Binding Details}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DCE3EC" BorderThickness="0,0,0,1" Padding="5,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Window>
