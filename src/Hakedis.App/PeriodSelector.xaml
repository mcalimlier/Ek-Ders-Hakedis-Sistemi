<UserControl x:Class="Hakedis.App.PeriodSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Hakedis.Contracts;assembly=Hakedis.Contracts">
 <StackPanel>
  <StackPanel IsEnabled="{Binding CanChangePeriod}">
  <TextBlock Text="Modül seçimi" Style="{StaticResource FieldLabel}"/>
  <ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" DisplayMemberPath="DisplayName" Margin="0,5,0,12"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{x:Static c:ExcelHeadings.Month}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Months}" DisplayMemberPath="Name" SelectedValuePath="Number" SelectedValue="{Binding Month, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="{x:Static c:ExcelHeadings.Year}" Style="{StaticResource FieldLabel}"/><ComboBox Style="{StaticResource FormCombo}" ItemsSource="{Binding Years}" SelectedItem="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  </Grid>
  </StackPanel>
  <TextBlock Text="{Binding PeriodText}" Foreground="{StaticResource Gold500Brush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
  <TextBlock Text="Dönemi değiştirmeden önce girişleri kaydedin veya çalışmayı temizleyin." TextWrapping="Wrap" Margin="0,5,0,0">
   <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CanChangePeriod}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
