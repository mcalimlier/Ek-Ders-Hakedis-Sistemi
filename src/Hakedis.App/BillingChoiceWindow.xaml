<Window x:Class="Hakedis.App.BillingChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Bu ayın ödeme modülünü seçin" Width="650" Height="680" MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource WorkspaceCard}"><StackPanel>
 <TextBlock Text="Tek kişi · Tek ay · Tek bordro" Style="{StaticResource CardTitle}"/>
 <TextBlock Text="{Binding PersonText}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"/>
 <TextBlock Text="{Binding PeriodText}" Foreground="#E8C778" FontWeight="Bold" Margin="0,0,0,12"/>
 <TextBlock Text="{Binding HistoryText}" Style="{StaticResource CardSubtitle}" TextWrapping="Wrap" Margin="0,0,0,14"/>
 <TextBlock Text="Bu ayın hakedişinin tamamı hangi modülden ödenecek?" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
 <ComboBox x:Name="BillingModuleCombo" Style="{StaticResource FormCombo}" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}" DisplayMemberPath="Name" Margin="0,6,0,16"/>
 <TextBlock Text="{Binding ExistingInputsText}" Style="{StaticResource CardSubtitle}" TextWrapping="Wrap" Margin="0,0,0,16"/>
 <TextBlock Text="Ayın tamamına ait toplamlar" Foreground="White" FontWeight="Bold" Margin="0,0,0,12"/>
 <TextBlock Text="GÜNDÜZ DERS SAATİ" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding DayHours,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
 <TextBlock Text="DESTEKLEME VE YETİŞTİRME KURSU" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding DykHours,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
 <TextBlock Text="İCRA KESİNTİSİ / MANUEL GİRİŞ" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" Text="{Binding Garnishment,UpdateSourceTrigger=PropertyChanged}"/>
 <TextBlock Text="{Binding Status}" Style="{StaticResource ValidationText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </StackPanel></Border></ScrollViewer>
 <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="ConfirmBillingChoiceButton" Content="Tercihi kaydet ve devam et" Style="{StaticResource GoldAction}" IsEnabled="{Binding CanAccept}" Click="Confirm_Click"/><Button Content="Vazgeç" Style="{StaticResource SecondaryAction}" IsCancel="True"/></WrapPanel>
 </Grid>
</Window>
