<UserControl x:Class="Hakedis.App.SearchableOccupation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <ToggleButton x:Name="Picker" Height="38" Background="#082744" Foreground="White" BorderBrush="#607C94" BorderThickness="1" Padding="9,4" HorizontalContentAlignment="Stretch" ToolTip="Meslek kodu seçin">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedText" Text="Meslek kodu seçin" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="▾" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
  </ToggleButton>
  <Popup x:Name="DropDown" IsOpen="{Binding IsChecked, ElementName=Picker}" PlacementTarget="{Binding ElementName=Picker}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="Popup_Opened">
   <Border Background="White" BorderBrush="#B28B39" BorderThickness="1" CornerRadius="8" Padding="10" Width="620" MaxWidth="700">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" Height="34" TextChanged="Search_Changed" ToolTip="Kod veya meslek adını yazın" Padding="8" Foreground="#14263F" Background="#F1F5F9"/>
     <TextBlock x:Name="Count" Grid.Row="1" Foreground="#526277" Margin="0,6"/>
     <ListBox x:Name="Options" Grid.Row="2" DisplayMemberPath="Display" Background="White" Foreground="#14263F" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseLeftButtonUp="Option_Click" PreviewKeyDown="Option_KeyDown"/>
    </Grid>
   </Border>
  </Popup>
 </Grid>
</UserControl>
